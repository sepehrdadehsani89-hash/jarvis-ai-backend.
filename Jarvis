
export default function handler(req, res) {
  if (req.method !== "GET") {
    return res.status(405).json({
      error: "Method not allowed"
    });
  }

  return res.status(200).json({
    status: "online",
    assistant: "J.A.R.V.I.S.",
    version: "1.3",
    message: "Backend is running"
  });
}
